import Conde1963.Provenance

/-!
# Evidence-constrained simulation parameters

This is a *logical interface* between historical observations and numerical
simulators, not an orbital propagator or an empirical proof of impact.
A constraint must carry documentary lineage and its assumptions separately.
-/

namespace Conde1963

/-- Any future calibrated physical parameter vector can instantiate `α`.
    A proof of this predicate does not compute an orbit by itself. -/
abbrev ParameterConstraint (α : Type) := α → Prop

/-- A candidate satisfies every accepted constraint. -/
def Allowed {α : Type} (constraints : List (ParameterConstraint α)) (p : α) : Prop :=
  ∀ constraint, constraint ∈ constraints → constraint p

/-- Reject contradictory premise collections rather than declaring a
    location uniquely identified by an empty candidate set. -/
def HasCandidate {α : Type} (constraints : List (ParameterConstraint α)) : Prop :=
  ∃ p, Allowed constraints p

/-- A document can motivate a constraint without certifying its truth.
    Only `.admitted` clauses narrow the current chosen scenario; the
    reviewer must justify that decision from sources and physical premises. -/
inductive ConstraintUse where
  | admitted | scenarioOnly | exploratory
  deriving Repr, DecidableEq, BEq

/-- A matrix label alone is not always unique: C44-C46 each occur twice.
    `occurrence` is an explicit disambiguator; no documentary text or
    numerical measurement is generated by this structure. -/
structure SourcedConstraint (α : Type) where
  matrixLabel : String
  occurrence : Nat
  chain : Chain
  grade : Grade
  use : ConstraintUse
  condition : ParameterConstraint α

/-- Only the selected scenario's admissible implications become hard
    predicates. Hypotheses remain available for separate scenario studies. -/
def AllowedFromSources {α : Type}
    (records : List (SourcedConstraint α)) (p : α) : Prop :=
  ∀ record, record ∈ records →
    record.use = ConstraintUse.admitted → record.condition p

theorem source_narrowing_never_adds_parameters {α : Type}
    (records : List (SourcedConstraint α))
    (extra : SourcedConstraint α) (p : α)
    (h : AllowedFromSources (extra :: records) p) :
    AllowedFromSources records p := by
  intro record present admitted
  exact h record (List.mem_cons_of_mem extra present) admitted

/-- Certified finite-domain evaluator: every executable predicate must
    be proved equivalent to its declarative Lean constraint. A search
    grid or list is *not* proof that continuous trajectories were covered. -/
structure ExecutableRule (α : Type) where
  source : SourcedConstraint α
  accepts : α → Bool
  corresponds : ∀ p, accepts p = true ↔ source.condition p

/-- Concrete parameter choices supplied to the numerical simulator.
    The list is exhaustively filtered *only relative to its input grid*. -/
def filterCandidateGrid {α : Type}
    (candidates : List α) (rules : List (ExecutableRule α)) : List α :=
  candidates.filter (fun p =>
    rules.all (fun r =>
      (r.source.use != ConstraintUse.admitted) || r.accepts p))

/-- Filtering cannot fabricate a parameter vector outside the source grid. -/
theorem filter_grid_never_creates_candidates {α : Type}
    (candidates : List α) (rules : List (ExecutableRule α))
    (p : α) (h : p ∈ filterCandidateGrid candidates rules) :
    p ∈ candidates := by
  exact (List.mem_filter.mp h).1

/-- Appending a new constraint never admits parameters previously excluded. -/
theorem narrowing_never_adds_parameters {α : Type}
    (constraints : List (ParameterConstraint α))
    (extra : ParameterConstraint α) (p : α)
    (h : Allowed (extra :: constraints) p) :
    Allowed constraints p := by
  intro c hc
  exact h c (List.mem_cons_of_mem extra hc)

/-- A new constraint can also eliminate every candidate, signalling a
    contradiction or unsupported assumptions, not evidence for any location. -/
theorem contradiction_has_no_candidate {α : Type}
    (constraints : List (ParameterConstraint α))
    (h : ∀ p, ¬ Allowed constraints p) :
    ¬ HasCandidate constraints := by
  intro existsCandidate
  obtain ⟨p, hp⟩ := existsCandidate
  exact h p hp

/-- A numerical simulator's *conditional* output. The optional impact
    distinguishes atmospheric decay/reentry from a proven ground impact.
    No observed position or timestamp is populated here. -/
structure TimeLocation where
  epochMinuteUTC : Nat
  latitudeMicrodegrees : Int
  longitudeMicrodegrees : Int
  deriving Repr, DecidableEq

/-- "Conde is excluded" requires a nonempty feasible parameter set and
    excludes every predicted impact inside the specified Conde region. -/
def ExcludesConde {α : Type}
    (constraints : List (ParameterConstraint α))
    (impact : α → Option TimeLocation)
    (inConde : TimeLocation → Prop) : Prop :=
  HasCandidate constraints ∧
  ∀ p, Allowed constraints p →
    ∀ whereAt, impact p = some whereAt → ¬ inConde whereAt

/-- "Conde is forced" requires EVERY surviving parameter choice to
    predict a ground impact in Conde. Merely exhibiting one path is not enough. -/
def ForcesConde {α : Type}
    (constraints : List (ParameterConstraint α))
    (impact : α → Option TimeLocation)
    (inConde : TimeLocation → Prop) : Prop :=
  HasCandidate constraints ∧
  ∀ p, Allowed constraints p →
    ∃ whereAt, impact p = some whereAt ∧ inConde whereAt

/-- Exact time/location identification is even stronger than exclusion:
    ALL feasible parameter choices must produce the same impact event. -/
def UniqueImpact {α : Type}
    (constraints : List (ParameterConstraint α))
    (impact : α → Option TimeLocation) : Prop :=
  ∃ event : TimeLocation, HasCandidate constraints ∧
    ∀ p, Allowed constraints p → impact p = some event

/-- No coherent nonempty admitted model may simultaneously force
    and exclude a ground impact in the same Conde region. -/
theorem forced_and_excluded_conde_conflict {α : Type}
    (constraints : List (ParameterConstraint α))
    (impact : α → Option TimeLocation)
    (inConde : TimeLocation → Prop)
    (forced : ForcesConde constraints impact inConde)
    (excluded : ExcludesConde constraints impact inConde) : False := by
  obtain ⟨p, hp⟩ := forced.1
  obtain ⟨event, hevent, inside⟩ := forced.2 p hp
  exact excluded.2 p hp event hevent inside

/-- A permitted tighter interval/region is a predicate on the output,
    not a made-up numerical value. -/
def ImpactInside {α : Type}
    (constraints : List (ParameterConstraint α))
    (impact : α → Option TimeLocation)
    (window : TimeLocation → Prop) : Prop :=
  HasCandidate constraints ∧
  ∀ p, Allowed constraints p →
    ∃ event, impact p = some event ∧ window event

/-- Correct monotonicity requires a witness that the new premises remain
    consistent. Without it the claim would be vacuous. -/
theorem exclusion_persists_under_consistent_narrowing {α : Type}
    (constraints : List (ParameterConstraint α))
    (extra : ParameterConstraint α)
    (impact : α → Option TimeLocation)
    (inConde : TimeLocation → Prop)
    (old : ExcludesConde constraints impact inConde)
    (stillPossible : HasCandidate (extra :: constraints)) :
    ExcludesConde (extra :: constraints) impact inConde := by
  refine ⟨stillPossible, ?_⟩
  intro p hp event hevent
  exact old.2 p (narrowing_never_adds_parameters constraints extra p hp) event hevent

/-- A genuine unique impact entails a bounded time/location window only
    if that very event is proved to lie in the window. -/
theorem unique_impact_entails_window {α : Type}
    (constraints : List (ParameterConstraint α))
    (impact : α → Option TimeLocation)
    (window : TimeLocation → Prop)
    (unique : UniqueImpact constraints impact)
    (inside : ∀ event, (∀ p, Allowed constraints p → impact p = some event) → window event) :
    ImpactInside constraints impact window := by
  obtain ⟨event, nonempty, hall⟩ := unique
  refine ⟨nonempty, ?_⟩
  intro p hp
  exact ⟨event, hall p hp, inside event hall⟩

/-- A statement that ALL admissible impacts occur in Conde cannot coexist
    with an admissible impact provably outside Conde. -/
theorem counterexample_refutes_forced_conde {α : Type}
    (constraints : List (ParameterConstraint α))
    (impact : α → Option TimeLocation)
    (inConde : TimeLocation → Prop)
    (p : α) (hp : Allowed constraints p)
    (event : TimeLocation)
    (hevent : impact p = some event)
    (outside : ¬ inConde event) :
    ¬ ForcesConde constraints impact inConde := by
  intro forced
  obtain ⟨other, hother, hin⟩ := forced.2 p hp
  have same : other = event := by
    have eq : (some other : Option TimeLocation) = some event := hother.symm.trans hevent
    exact Option.some.inj eq
  exact outside (same ▸ hin)

end Conde1963
