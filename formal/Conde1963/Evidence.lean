  { id := 71, variant := 1, uniqueId := "C71", summary := "1963-3A e 1963-3C em lista de órbitas de 15/11, 3B em adendo de decaídos", sourceRow := "| **C71** | 1963-3A e 1963-3C em lista de órbitas de 15/11, 3B em adendo de decaídos | Primário coevo, NASA 15/11, p. impressa 5 e 8 | Confirma estado da família de objetos em novembro, não identifica 3B como peça física |", grade := none, outcome := none, chain := none },
  { id := 72, variant := 1, uniqueId := "C72", summary := "SATCAT moderno reproduz essas duas datas do informe coevo", sourceRow := "| **C72** | SATCAT moderno reproduz essas duas datas do informe coevo | Comparação de séries institucionais potencialmente dependentes | Consistência temporal; **não contar como duas observações de reentrada independentes** |", grade := none, outcome := none, chain := none },
  { id := 73, variant := 1, uniqueId := "C73", summary := "Título “II Guerra dos Mundos na Versão Baiana”, coluna assinada Stanislaw Ponte Preta", sourceRow := "| C73 | Título “II Guerra dos Mundos na Versão Baiana”, coluna assinada Stanislaw Ponte Preta | [*Última Hora* Nordeste, 14/11/1963, n. 477](https://hemeroteca-pdf.bn.gov.br/765147/per765147_1963_00477.pdf), OCR linhas 18388–18417 | Documento jornalístico contemporâneo lido por OCR, sem captura visual da página | Confirma autoria/título em transcrição; conferir imagem quando viável |", grade := none, outcome := none, chain := none },
  { id := 74, variant := 1, uniqueId := "C74", summary := "Versão narrativa: satélite → satélite tripulado → disco voador", sourceRow := "| C74 | Versão narrativa: satélite → satélite tripulado → disco voador | Mesmo OCR, linhas 18529–18680 | Memória satírica de circulação jornalística 6 dias depois; **não** primeira ocorrência primária anterior a 8/11 | Confirma a versão publicada em 14/11, **não** a sequência factual nem a queda |", grade := none, outcome := none, chain := none },
  { id := 75, variant := 1, uniqueId := "C75", summary := "“Sujeito ponderado” teria reconhecido balão de sondagem", sourceRow := "| C75 | “Sujeito ponderado” teria reconhecido balão de sondagem | Mesmo OCR, linhas 18687–18710; cotejo com telegrama 157 no A-628 | Passagem de crônica humorística versus apuração diplomática | Não é testemunho físico verificável; a identificação por balão continua não confirmada |", grade := none, outcome := none, chain := none },
