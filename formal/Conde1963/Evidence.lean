  { id := 59, variant := 1, uniqueId := "C59", summary := "Documento técnico original ARINC/Lockheed de 31/01/1961 sobre SAMOS F-2 (veículo 2301) registra mudança para Thor, retirada das matrizes solares e operação apenas com baterias", sourceRow := "| C59 | Documento técnico original ARINC/Lockheed de 31/01/1961 sobre SAMOS F-2 (veículo 2301) registra mudança para Thor, **retirada das matrizes solares e operação apenas com baterias** | Documento primário do projeto, *Second Periodic Review of the Orbit Reliability of the SAMOS F-2 System*, C05100062, preliminares: https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007cc.pdf | PDF primário indexado/texto consultado; captura de página visual indisponível via portal (403). **Desenho antecedente**: não prova cada detalhe do FTV 2313; elimina justificativa automática de grandes painéis solares |", grade := none, outcome := none, chain := none },
  { id := 60, variant := 1, uniqueId := "C60", summary := "NRO possui registro nominal “SIGINT Mission 7153”, e “FERRET-3 System” no índice de acervo SIGINT Phase II", sourceRow := "| C60 | NRO possui registro nominal **“SIGINT Mission 7153”**, e **“FERRET-3 System”** no índice de acervo SIGINT Phase II | Índice original https://www.nro.gov/foia-home/foia-declassified-nro-programs-and-projects/SIGINT-Phase-II-Records/ | **Localização arquivística confirmada** por indexação; PDF mission-specific e anexos ainda NÃO obtidos (403), portanto não presumir conteúdo/dimensões |", grade := none, outcome := none, chain := none },
  { id := 61, variant := 1, uniqueId := "C61", summary := "Vínculo de escala do veículo: GCAT registra massa útil seca ~306 kg, massa total associada ~1176 kg, corpo irregular de ~1,5 m de diâmetro; 528/529 não têm dimensões/pesos preenchidos", sourceRow := "| C61 | Vínculo de escala do veículo: GCAT registra massa útil seca ~306 kg, massa total associada ~1176 kg, corpo irregular de ~1,5 m de diâmetro; 528/529 não têm dimensões/pesos preenchidos | GCAT S00527–S00529 e Agena B A00324, https://planet4589.org/space/gcat/data/cat/satcat.html ; NASA/Smithsonian exibe exemplar de Agena B em https://airandspace.si.edu/collection-objects/upper-stage-launch-vehicle-agena-b/nasm_A19650291000 | Catálogo secundário físico e exemplar de mesmo modelo; **não** identificação do modelo específico dos detritos. Valores 0 de 528/529 são placeholders desconhecidos |", grade := none, outcome := none, chain := none },
  { id := 62, variant := 1, uniqueId := "C62", summary := "Primeiras frequências orbitais 527=15,23280457, 528=15,25978323, 529=15,22642839 rev/dia; diferenças de semieixo -8,10 km e +1,92 km e impulsos tangenciais aproximados de -4,49/+1,06 m/s", sourceRow := "| C62 | Primeiras frequências orbitais 527=15,23280457, 528=15,25978323, 529=15,22642839 rev/dia; diferenças de semieixo -8,10 km e +1,92 km e impulsos tangenciais aproximados de -4,49/+1,06 m/s | TLEs Space-Track espelhados, já usados em C25. Cálculo reprodutível em `conde_1963_calculos_coberturas.py` | **Inferência cinemática aproximada** (TLEs em épocas diferentes, sem modelo de eclosão/arrasto/orbita exata). Permite velocidade relativa pequena compatível com liberação de componente; não identifica fisicamente nem prova mecanismo |", grade := none, outcome := none, chain := none },
  { id := 63, variant := 1, uniqueId := "C63", summary := "Usando β528=5,61 kg/m², Cd_orbita=2,2 e uma seção circular nominal de 0,5, 1 e 2m de diâmetro, massas seriam respectivamente ~2,4, 9,7 e 38,8 kg", sourceRow := "| C63 | Usando β528=5,61 kg/m², Cd_orbita=2,2 e uma seção circular nominal de 0,5, 1 e 2m de diâmetro, massas seriam respectivamente ~2,4, 9,7 e 38,8 kg | C39 e modelo geométrico condicional; `conde_1963_calculos_coberturas.py` | Cálculo dependente do mesmo TLE e modelo atmosférico; **não são massas medidas e não são limites estatísticos**. Repete β de C39, não nova observação |", grade := none, outcome := none, chain := none },
  { id := 64, variant := 1, uniqueId := "C64", summary := "[NRO — SIGINT Mission 7153](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007m.pdf)", sourceRow := "| **C64** | [NRO — SIGINT Mission 7153](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007m.pdf) | Arquivo primário de 2 páginas, link original localizado | Link primário confirmado; extração parcial | Confirmado com limitação |", grade := none, outcome := none, chain := none },
  { id := 65, variant := 1, uniqueId := "C65", summary := "[7153](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007m.pdf) e [7154](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007l.pdf)", sourceRow := "| **C65** | [7153](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007m.pdf) e [7154](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007l.pdf) | Ambas as extrações exibem 250 órbitas programadas de coleta, 83 h e saída digital | Texto de fonte primária via OCR, sem fac-símile visual | Provisório |", grade := none, outcome := none, chain := none },
  { id := 66, variant := 1, uniqueId := "C66", summary := "[NRO — FERRET-3 System](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007t.pdf), [história institucional](https://www.governmentattic.org/19docs/NRO-SIGINTsatStory_1994u.pdf)", sourceRow := "| **C66** | [NRO — FERRET-3 System](https://www.nro.gov/Portals/135/documents/foia/declass/sigintphaseii/SC-2017-00007t.pdf), [história institucional](https://www.governmentattic.org/19docs/NRO-SIGINTsatStory_1994u.pdf) | Arquivo FERRET-3 de 1 página sem extração legível; missão 7153 corresponde ao F-2 digital, não ao F-3 analógico | Documento primário identificado + comparação de nomenclatura | Referência cruzada, sem identificação material |", grade := none, outcome := none, chain := none },
