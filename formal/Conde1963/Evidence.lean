  { id := 77, variant := 1, uniqueId := "C77", summary := "Edição do *Jornal do Brasil* de sábado 09/11/1963, 1º Caderno, p. 12, notícia sob manchete “Baiano enxergou material do Serviço Meteorológico e pensou que fôsse satélite”", sourceRow := "| **C77** | Edição do *Jornal do Brasil* de sábado **09/11/1963**, 1º Caderno, p. 12, notícia sob manchete **“Baiano enxergou material do Serviço Meteorológico e pensou que fôsse satélite”** | **Jornal original coevo**, cabeçalho e título diretamente verificados por imagem | **Confirmada** presença do tema balão/satélite na imprensa carioca do próprio dia seguinte; manchete não demonstra que houve balão real |", grade := some .originalInspected, outcome := some .confirmedAsDocument, chain := some .jornalBrasil },
  { id := 78, variant := 1, uniqueId := "C78", summary := "Matéria atribui ao coronel Francisco Cabral, chefe de Polícia, declaração “ontem” de que não seria satélite metálico tripulado e sim balão de sondagem do Serviço de Meteorologia, levado pelo vento", sourceRow := "| **C78** | Matéria atribui ao coronel **Francisco Cabral**, chefe de Polícia, declaração **“ontem”** de que não seria satélite metálico tripulado e sim balão de sondagem do Serviço de Meteorologia, levado pelo vento | **Atribuição jornalística coeva**, conteúdo narrado na transcrição intermediária da página original | **Confirmado como relato publicado**, não confirmação física de balão ou prova da hora exata da declaração em 08/11 |", grade := none, outcome := none, chain := none },
  { id := 79, variant := 1, uniqueId := "C79", summary := "Mesma matéria registra já em 09/11 as expressões satélite metálico tripulado e homem do espaço", sourceRow := "| **C79** | Mesma matéria registra já em 09/11 as expressões **satélite metálico tripulado** e **homem do espaço** | Jornal coevo, relato mediado na transcrição | Enfraquece inferência de que \"tripulado\" tenha aparecido apenas na crônica de 14/11; não data primeira versão só com \"satélite\" |", grade := none, outcome := none, chain := none },
  { id := 80, variant := 1, uniqueId := "C80", summary := "Seção FAB INVESTIGA relata troca de telegramas com Salvador, o não aparecimento do satélite e desmentido do gabinete do Ministro da Aeronáutica", sourceRow := "| **C80** | Seção **FAB INVESTIGA** relata troca de telegramas com Salvador, o não aparecimento do satélite e desmentido do gabinete do Ministro da Aeronáutica | Jornal coevo relatando autoridades | Compatível com o desmentido do *Diário de Notícias* de 09/11 resumido no A-628, **mesma autoridade pode ser fonte comum; não contar automaticamente como duas verificações independentes** |", grade := none, outcome := none, chain := none },
  { id := 81, variant := 1, uniqueId := "C81", summary := "Matéria não identifica morador testemunha, balão recolhido, lançamento de radiossonda, local/hora exato do suposto impacto", sourceRow := "| **C81** | Matéria não identifica morador testemunha, balão recolhido, lançamento de radiossonda, local/hora exato do suposto impacto | Inspeção de conteúdo narrado da matéria; evidência negativa limitada ao texto | A afirmação de balão pelo chefe policial **não foi materialmente corroborada**; consulado em 14/11 a considerou especulação sem avistamento confirmado |", grade := none, outcome := none, chain := none },
  { id := 82, variant := 1, uniqueId := "C82", summary := "Identificação provável entre Francisco Cabral nomeado no JB e secretário de Segurança Pública não nomeado no telegrama 157", sourceRow := "| **C82** | Identificação provável entre **Francisco Cabral** nomeado no JB e **secretário de Segurança Pública** não nomeado no telegrama 157 | Cruzamento com *Brasil, Urgente*, ed. 51, p. 17, https://hemeroteca-pdf.bn.gov.br/761680/per761680_1963_00051.pdf (edição aparentemente de 1964, índice textual), além do A-628 | **Inferência com apoio documental**: pessoa e cargo conectados; conferir data funcional de novembro de 1963. O nome em ambas as fontes não constitui confirmação de balão |", grade := none, outcome := none, chain := none },
  { id := 83, variant := 1, uniqueId := "C83", summary := "Linha Salvador (Do Correspondente) e expressão ontem relatadas para a matéria publicada em 9/11", sourceRow := "| **C83** | Linha **Salvador (Do Correspondente)** e expressão **ontem** relatadas para a matéria publicada em 9/11 | Fonte editorial baiana dentro de jornal carioca, com data de publicação; mediada por transcrição | **Não** prova que Tupi tenha sido a origem. Pode indicar informação circulando na Bahia já em 08/11; sem horário e matriz das fontes, qualquer precedência é hipótese |", grade := none, outcome := none, chain := none },
  { id := 84, variant := 1, uniqueId := "C84", summary := "Relação histórica do secretariado 1963–1967 nomeia o secretário como Francisco Cabral de Andrade, https://www.recantodasletras.com.br/ensaios/2216214 ; pesquisa histórica com referência a assinatura de 02/07/1964, https://www2.uesb.br/editora/wp-content/uploads/Uma-cidade_miolo-corrigido.pdf", sourceRow := "| **C84** | Relação histórica do secretariado 1963–1967 nomeia o secretário como **Francisco Cabral de Andrade**, https://www.recantodasletras.com.br/ensaios/2216214 ; pesquisa histórica com referência a assinatura de 02/07/1964, https://www2.uesb.br/editora/wp-content/uploads/Uma-cidade_miolo-corrigido.pdf | Duas referências históricas retrospectivas sobre a **identidade/cargo**, não prova da existência de balão; reportagem *JB* 09/11 nomeia somente Francisco Cabral | **Provável identificação mais completa** do personagem C78/C82; ato nominativo de 1963 ainda a verificar |", grade := none, outcome := none, chain := none },
  { id := 85, variant := 1, uniqueId := "C85", summary := "Catálogo BN https://acervo.bn.gov.br/sophia_web/acervo/detalhe/1112893 : *Jornal da Bahia* código `815063` publicado em 1853–1878", sourceRow := "| **C85** | Catálogo BN https://acervo.bn.gov.br/sophia_web/acervo/detalhe/1112893 : *Jornal da Bahia* código `815063` publicado em **1853–1878** | **Fonte primária catalográfica** de identificação da coleção; não é reportagem de 1963 | **Refutado** que este código dê acesso ao *Jornal da Bahia* fundado em 1958, edição de 11/11/1963 |", grade := none, outcome := none, chain := none },
  { id := 86, variant := 1, uniqueId := "C86", summary := "BN DocReader https://memoria.bn.gov.br/DocReader/docreader.aspx?PagFis=31360&bib=093718_04 se intitula *Diário de Notícias (RJ)*", sourceRow := "| **C86** | BN DocReader https://memoria.bn.gov.br/DocReader/docreader.aspx?PagFis=31360&bib=093718_04 se intitula *Diário de Notícias (RJ)* | Fonte primária de metadado de coleção; homônimo | **Refutado** que `093718_04` seja o *Diário de Notícias* de Salvador de 09/11/1963 |", grade := none, outcome := none, chain := none },
  { id := 87, variant := 1, uniqueId := "C87", summary := "Catálogo BN https://acervo.bn.gov.br/sophia_web/acervo/detalhe/871386 descreve *Diário de Notícias* (Salvador) e anos digitalizados apenas selecionados até 1909 (DocReader `098167`)", sourceRow := "| **C87** | Catálogo BN https://acervo.bn.gov.br/sophia_web/acervo/detalhe/871386 descreve *Diário de Notícias* (Salvador) e anos digitalizados apenas selecionados até 1909 (DocReader `098167`) | Fonte **catalográfica primária**, resultado indexado (acesso direto retornou 403) | **Fascículo 09/11/1963 não localizado no acervo digital consultado**; não significa inexistência física |", grade := none, outcome := none, chain := none },
  { id := 88, variant := 1, uniqueId := "C88", summary := "IGHB https://www.ighb.org.br/biblioteca lista coleções com abrangências 1875–1980 e 1959–1994; Nelson Cadena 2018 https://www.correio24horas.com.br/colunistas/nelson-cadena/pela-digitalizacao-dos-periodicos-ja-publicados-na-bahia-1018 criticou ausência de digitalização do século XX", sourceRow := "| **C88** | IGHB https://www.ighb.org.br/biblioteca lista coleções com abrangências **1875–1980** e **1959–1994**; Nelson Cadena 2018 https://www.correio24horas.com.br/colunistas/nelson-cadena/pela-digitalizacao-dos-periodicos-ja-publicados-na-bahia-1018 criticou ausência de digitalização do século XX | **Fonte primária institucional de acervo** + testemunho jornalístico retrospectivo sobre acessibilidade em 2018 | Rota física do IGHB confirmada no catálogo; a situação atual de cada fascículo não foi confirmada individualmente |", grade := none, outcome := none, chain := none },
  { id := 89, variant := 1, uniqueId := "C89", summary := "Nenhum registro localizado da fonte meteorológica informante de Cabral, lauda de rádio original, telegramas FAB/Salvador ou recortes originais", sourceRow := "| **C89** | Nenhum registro localizado da fonte meteorológica informante de Cabral, lauda de rádio original, telegramas FAB/Salvador ou recortes originais | Resultado **negativo restrito à estratégia de busca** e aos catálogos consultados, não prova de inexistência | **Questão aberta**: descobrir quem informou Cabral em 08/11/1963 |", grade := none, outcome := none, chain := none },
  { id := 90, variant := 1, uniqueId := "C90", summary := "NASA publicava boletins com dados de rastreamento disponibilizados pelo NORAD; acordo GSFC–NORAD de 7/11/1961, atualizado em maio/1962, previa controle militar do fluxo de dados", sourceRow := "| **C90** | NASA publicava boletins com dados de rastreamento disponibilizados pelo NORAD; acordo GSFC–NORAD de 7/11/1961, atualizado em maio/1962, previa controle militar do fluxo de dados | **Fonte primária governamental posterior**: US House Report 197, 22/03/1965, p. impressa 7–8, https://www.govinfo.gov/content/pkg/SERIALSET-12667_05_00-002-0197-0000/pdf/SERIALSET-12667_05_00-002-0197-0000.pdf; texto PDF recuperado pela pesquisa, captura visual falhou por timeout | **Confirmado o arranjo institucional documentado pelo Congresso**; NASA 1963 e SATCAT moderno podem ter dependência comum de origem NORAD, não duas observações independentes |", grade := none, outcome := none, chain := none },
  { id := 91, variant := 1, uniqueId := "C91", summary := "Boletins públicos da NASA omitiram determinados lançamentos soviéticos classificados em 1962–1963; Comissão descreve lacunas nos identificadores, com omissões até junho/1963", sourceRow := "| **C91** | Boletins públicos da NASA omitiram determinados lançamentos soviéticos classificados em 1962–1963; Comissão descreve lacunas nos identificadores, com omissões até junho/1963 | **Fonte primária parlamentar posterior**: mesmo House Report 197, p. impressa 8–9 | **Refutada inferência de completude obrigatória do catálogo público**. Documento não afirma que havia outros objetos desconhecidos em 7–8/11/1963 nem desmente os lançamentos listados |", grade := none, outcome := none, chain := none },
  { id := 92, variant := 1, uniqueId := "C92", summary := "OPS 1561 / 1963-035A / NORAD 637 pertence à família de satélites de reconhecimento fotográfico ARGON/KH-5, com lançamento de 29/08/1963", sourceRow := "| **C92** | OPS 1561 / 1963-035A / NORAD 637 pertence à família de satélites de reconhecimento fotográfico ARGON/KH-5, com lançamento de 29/08/1963 | **Reconstrução histórico-catalográfica**: GCAT Jonathan McDowell https://planet4589.org/space/gcat/data/derived/currentcat.html ; registro de lançamentos https://planet4589.org/space/gcat/data/derived/launchlog.html ; comparação https://space.skyrocket.de/doc_sdat/kh-5_ad.htm | **Identificação consistente**, mas não é observação independente de local da queda. Fontes divergem na numeração coloquial “ARGON 11” x “KH-5 9”; identificadores estáveis são 637/1963-035A/OPS 1561 |", grade := none, outcome := none, chain := none },
  { id := 93, variant := 1, uniqueId := "C93", summary := "Veículo Agena nº 1169 foi lançado em 29/08/1963; 637 é descrito em catálogo reconstruído como reentrando em 07/11 acoplado ao estágio Agena D 1169", sourceRow := "| **C93** | Veículo Agena nº 1169 foi lançado em 29/08/1963; 637 é descrito em catálogo reconstruído como reentrando em 07/11 **acoplado ao estágio Agena D 1169** | **Corroboração primária parcial** para número do estágio e data de lançamento em *Agena Flight History*, histórico da Força Aérea elaborado em 1969 e desclassificado, https://www.nro.gov/Portals/135/documents/foia/declass/WS117L_Records/276.PDF (texto indexado; fac-símile não capturado via ferramenta por 403). Associação reentrada acoplada no GCAT https://planet4589.org/space/gcat/data/derived/currentcat.html e https://planet4589.org/space/gcat/data/cat/auxcat.html | **Candidato mais complexo que satélite isolado**: estrutura de estágio pode ter reentrado junto. A ligação física com Conde é **não demonstrada**; massa e geometria do conjunto na reentrada ainda não verificadas em documento de rastreamento de 1963 |", grade := none, outcome := none, chain := none },
  { id := 94, variant := 1, uniqueId := "C94", summary := "GCAT estima para Agena D 1169 dimensões ~6,3 m por 1,5 m e massa catalogada de 900 kg; fontes de satélites isolados informam massa ~101 kg para payload ARGON", sourceRow := "| **C94** | GCAT estima para Agena D 1169 dimensões ~6,3 m por 1,5 m e massa catalogada de 900 kg; fontes de satélites isolados informam massa ~101 kg para payload ARGON | Catálogo técnico reconstruído GCAT auxcat, comparado a https://orbitalradar.com/satellite/637 ; não medição de destroço nem avaliação estrutural de sobrevivência | **Não somar massas automaticamente sem verificar se são massa de configuração inicial ou remanescente na reentrada**. Em qualquer caso, o conjunto não corresponde morfologicamente à descrição de esfera envidraçada com ocupante |", grade := none, outcome := none, chain := none },
  { id := 95, variant := 1, uniqueId := "C95", summary := "A missão OPS 1561 lançou a cápsula de retorno SRV 604; GCAT situa sua recuperação/retorno em 02/09/1963, muito antes da reentrada do 637 em 07/11", sourceRow := "| **C95** | A missão OPS 1561 lançou a cápsula de retorno SRV 604; GCAT situa sua recuperação/retorno em 02/09/1963, muito antes da reentrada do 637 em 07/11 | Catálogo técnico GCAT https://planet4589.org/space/gcat/data/cat/auxcat.html ; narrativa orbital secundária em https://space.skyrocket.de/doc_sdat/kh-5_ad.htm | **A cápsula de filme não é candidata à queda de 07–08/11** se a cronologia está correta. A hipótese de ocupante humano não é sustentada pelo desenho de reconhecimento fotográfico. Verificar log primário NRO de recuperação SRV 604 |", grade := none, outcome := none, chain := none },
  { id := 96, variant := 1, uniqueId := "C96", summary := "Novas buscas textuais de “Conde”, “satélite”, “Francisco Cabral”, notícias inglesas de 1963 e convenção `W` do FBIS não recuperaram fac-símile mais antigo nem norma editorial que estabeleça inequivocamente 23h30 em UTC", sourceRow := "| **C96** | Novas buscas textuais de “Conde”, “satélite”, “Francisco Cabral”, notícias inglesas de 1963 e convenção `W` do FBIS não recuperaram fac-símile mais antigo nem norma editorial que estabeleça inequivocamente 23h30 em UTC | Tentativa de busca pública de 10/11/2026; termo mais amplo levou principalmente a republicações de 2026 | **Negativo limitado ao método de busca**; não confundir ausência em buscador com inexistência de notícia, balão ou arquivo de rádio. Origem editorial e fuso permanecem abertos |", grade := none, outcome := none, chain := none },
  { id := 97, variant := 1, uniqueId := "C97", summary := "Decreto federal nº 52.667, 11/10/1963, aprovou o regimento do Serviço de Meteorologia do Ministério da Agricultura; art. 8º, III, definiu o Distrito de Meteorologia do Leste com sede em Salvador, responsável por Bahia e Sergipe. https://www2.camara.leg.br/legin/fed/decret/1960-1969/decreto-52667-11-outubro-1963-392920-publicacaooriginal-1-pe.html", sourceRow := "| **C97** | Decreto federal nº 52.667, **11/10/1963**, aprovou o regimento do Serviço de Meteorologia do Ministério da Agricultura; art. 8º, III, definiu o **Distrito de Meteorologia do Leste com sede em Salvador**, responsável por Bahia e Sergipe. https://www2.camara.leg.br/legin/fed/decret/1960-1969/decreto-52667-11-outubro-1963-392920-publicacaooriginal-1-pe.html | **Documento primário contemporâneo diretamente lido** em reprodução legislativa oficial; fonte independente do circuito jornalístico/consular | **Confirmado o órgão regional real** que poderia deixar registros e receber consultas técnicas. Não prova que lançou balão, nem identifica o fornecedor da notícia a Cabral. |", grade := none, outcome := none, chain := none },
  { id := 98, variant := 1, uniqueId := "C98", summary := "O mesmo regimento cria a Seção de Aerologia (arts. 2º e 15), responsável por estudos de circulação e métodos de sondagem atmosférica; sua Divisão de Observações e Arquivo Técnico recebem, verificam e arquivam dados (arts. 21–25); distritos devem remeter dados mensalmente à sede (art. 29).", sourceRow := "| **C98** | O mesmo regimento cria a **Seção de Aerologia** (arts. 2º e 15), responsável por estudos de circulação e métodos de sondagem atmosférica; sua Divisão de Observações e Arquivo Técnico recebem, verificam e arquivam dados (arts. 21–25); distritos devem remeter dados mensalmente à sede (art. 29). | **Documento primário**, mesmo que C97: **uma única fonte**, e não segunda prova de operação de balão em Salvador. | **Confirmado o circuito documental institucional**, inclusive distrito regional/arquivo central. A competência administrativa não demonstra execução de radiossondagem em Conde em 07–09/11. |", grade := none, outcome := none, chain := none },
  { id := 99, variant := 1, uniqueId := "C99", summary := "O inventário oficial NOAA/NCEI IGRA v2.2 lista `BRM00083229`, SALVADOR (83229-0), coordenadas aprox. 13,0167 S / 38,5167 W, com observações aerológicas disponíveis 1970–2018; não inclui 1963. https://www.ncei.noaa.gov/data/integrated-global-radiosonde-archive/doc/igra2-station-list.txt ; descrição https://www.ncei.noaa.gov/products/weather-balloon/integrated-global-radiosonde-archive", sourceRow := "| **C99** | O inventário oficial **NOAA/NCEI IGRA v2.2** lista `BRM00083229`, **SALVADOR (83229-0)**, coordenadas aprox. 13,0167 S / 38,5167 W, com observações aerológicas disponíveis **1970–2018**; não inclui 1963. https://www.ncei.noaa.gov/data/integrated-global-radiosonde-archive/doc/igra2-station-list.txt ; descrição https://www.ncei.noaa.gov/products/weather-balloon/integrated-global-radiosonde-archive | **Dados arquivísticos institucionais primários quanto à cobertura do próprio arquivo**, registro moderno retrospectivo; não se confunde com jornal ou consulado. O inventário mostra intervalo de dados conservados no IGRA, não total histórico de lançamentos da estação. | **Refutado que IGRA ofereça diretamente observações de Salvador de novembro de 1963 sob essa identificação**. **Não refutado** que existissem balões não preservados nesse conjunto. |", grade := none, outcome := none, chain := none },
  { id := 100, variant := 1, uniqueId := "C100", summary := "O regimento prevê radiossondagem e radiovento expressamente para o Observatório Meteorológico de Brasília (art. 26, IV), enquanto descreve no art. 29 as atribuições dos distritos regionais de maneira geral.", sourceRow := "| **C100** | O regimento prevê radiossondagem e radiovento **expressamente para o Observatório Meteorológico de Brasília** (art. 26, IV), enquanto descreve no art. 29 as atribuições dos distritos regionais de maneira geral. | **Comparação interna do mesmo decreto**, sem independência adicional | **Não se pode deduzir do regimento** que Salvador operasse uma estação de radiossondagem em novembro de 1963. Também não é prova de ausência; pode haver normas/órgãos meteorológicos da Aeronáutica não cobertos pelo decreto. |", grade := none, outcome := none, chain := none },
  { id := 101, variant := 1, uniqueId := "C101", summary := "Busca específica por `Conde` + `balão/satélite` e por radiossondagem baiana em 1963 não recuperou registro datado de lançamento, perda, rastreamento, localização ou recuperação; buscas por `FBIS W (TEXT)` tampouco trouxeram regra editorial contemporânea para o fuso.", sourceRow := "| **C101** | Busca específica por `Conde` + `balão/satélite` e por radiossondagem baiana em 1963 não recuperou registro datado de lançamento, perda, rastreamento, localização ou recuperação; buscas por `FBIS W (TEXT)` tampouco trouxeram regra editorial contemporânea para o fuso. | **Busca negativa restrita a fontes indexadas publicamente nesta sessão**; muitos resultados são reproduções de 2026 dependentes de FBIS/A-628 | **Aberto**: origem do balão, horário FBIS, documentação de sondeio real em Salvador. Ausência no IGRA e nos buscadores não tem valor de evidência física negativa. |", grade := none, outcome := none, chain := none },
  { id := 102, variant := 1, uniqueId := "C102", summary := "Cinemateca Brasileira/Banco de Conteúdos Culturais cataloga roteiros de locução originais do *Repórter Esso* da TV Tupi, canal 4, São Paulo, para 7, 8, 9, 11 e 12/11/1963, com PDFs fac-similares de 27, 24, 24, 23 e 23 páginas, respectivamente.", sourceRow := "| **C102** | Cinemateca Brasileira/Banco de Conteúdos Culturais cataloga roteiros de locução originais do *Repórter Esso* da **TV Tupi, canal 4, São Paulo**, para 7, 8, 9, 11 e 12/11/1963, com PDFs fac-similares de 27, 24, 24, 23 e 23 páginas, respectivamente. | **Fontes primárias coetâneas, folhas de rosto diretamente inspecionadas**: https://www.bcc.org.br/colecoes/tupi/textos?page=208 ; PDFs https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631107.pdf , `RE19631108.pdf`, `RE19631109.pdf`, `RE19631111.pdf`, `RE19631112.pdf`. | **Confirmada nova coleção de fontes da própria cadeia empresarial, com roteiro, não gravação integral nem prova de transmissão da matéria específica.** TV de São Paulo ≠ Rádio Tupi do Rio, embora ligadas à rede. |", grade := none, outcome := none, chain := none },
  { id := 103, variant := 1, uniqueId := "C103", summary := "Roteiro de 7/11/1963, item 1: “Mergulhadores procuram ‘Disco Voador’”. Página 2 descreve alegação de objeto brilhante semelhante a enorme bacia caindo nas águas de um afluente do rio Ribeira, região de Iguape/Miracatu, SP, e buscas de mergulhadores sem localizar objeto.", sourceRow := "| **C103** | Roteiro de 7/11/1963, item **1: “Mergulhadores procuram ‘Disco Voador’”**. Página 2 descreve alegação de objeto brilhante semelhante a enorme bacia caindo nas águas de um afluente do rio Ribeira, região de Iguape/Miracatu, SP, e buscas de mergulhadores sem localizar objeto. | **Documento primário de redação de telejornal, visualmente verificado**: https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631107.pdf , páginas PDF 1–2 (índices zero-based 0–1). | **Confirmado um rumor de queda de objeto voador já em 7/11 dentro da rede Tupi, MAS SOBRE OUTRO INCIDENTE E EM OUTRO ESTADO.** Não é evidência de evento em Conde. |", grade := none, outcome := none, chain := none },
  { id := 104, variant := 1, uniqueId := "C104", summary := "*O Estado* (Florianópolis), 7/11/1963, capa, publicou a chamada “Disco Voador Teria Caído em São Paulo”; notícia datada São Paulo, 6 (OE), sobre equipe enviada ao km 184 da BR-2 e rio em região de Iguape/Miracatu.", sourceRow := "| **C104** | *O Estado* (Florianópolis), **7/11/1963, capa**, publicou a chamada “Disco Voador Teria Caído em São Paulo”; notícia datada **São Paulo, 6 (OE)**, sobre equipe enviada ao km 184 da BR-2 e rio em região de Iguape/Miracatu. | **Jornal original de 1963, capa diretamente conferida**, Biblioteca Pública do Estado de SC: https://hemeroteca.ciasc.sc.gov.br/oestadofpolis/1963/EST196314805.pdf , página 1. | **Confirmada circulação impressa do rumor paulista em 7/11 e despacho datado do dia 6.** A notícia do jornal e a matéria televisiva podem compartilhar fonte; **não contam como duas testemunhas independentes de queda**. |", grade := none, outcome := none, chain := none },
  { id := 105, variant := 1, uniqueId := "C105", summary := "Roteiro paulista (7/11) e história de Conde do FBIS (8/11) compartilham tópico jornalístico genérico “objeto voador caiu”; diferem local (rio SP versus centro urbano baiano), suposta forma (“bacia” versus esfera envidraçada) e alegação de corpo (ausente no relato paulista).", sourceRow := "| **C105** | Roteiro paulista (7/11) e história de Conde do FBIS (8/11) compartilham tópico jornalístico genérico “objeto voador caiu”; diferem local (rio SP versus centro urbano baiano), suposta forma (“bacia” versus esfera envidraçada) e alegação de corpo (ausente no relato paulista). | **Comparação direta de dois registros primários diferentes**, usando https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631107.pdf e EOP-UAP-D001 https://uapreadingroom.com/file/eop-uap-d001/ . | **Hipótese de replicação literal entre notícias é contrariada pelo texto**. **Hipótese de contaminação editorial ou seleção de pauta dentro de grupo comum é plausível, mas NÃO demonstrada**. Teste: procurar pauta original, fontes e redação da rádio do Rio. |", grade := none, outcome := none, chain := none },
  { id := 106, variant := 1, uniqueId := "C106", summary := "Sumário/primeira página dos roteiros *Repórter Esso* 8, 9, 11 e 12/11/1963 não nomeia Conde, objeto caído ou satélite como pauta autônoma.", sourceRow := "| **C106** | Sumário/primeira página dos roteiros *Repórter Esso* **8, 9, 11 e 12/11/1963** não nomeia Conde, objeto caído ou satélite como pauta autônoma. | **Primeiras páginas visualmente inspecionadas**, PDFs https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631108.pdf , `RE19631109.pdf`, `RE19631111.pdf`, `RE19631112.pdf`. | **Achado negativo limitado ao SUMÁRIO**; roteiros de 23–24 páginas não foram lidos integralmente. Não prova que o caso nunca tenha aparecido em bloco internacional, notícia final ou rádio do Rio. |", grade := none, outcome := none, chain := none },
  { id := 107, variant := 1, uniqueId := "C107", summary := "Correspondência técnica da própria agência no FBIS Wire Service de 28/10/1962: item `FBIS 47` registra emissora original “MOSCOW DOMESTIC SERVICE IN RUSSIAN AT 1404 GMT ON 28 OCTOBER” e encerra com linha `28 OCT 928A FRK/HM`.", sourceRow := "| **C107** | Correspondência técnica da própria agência no **FBIS Wire Service** de 28/10/1962: item `FBIS 47` registra emissora original “MOSCOW DOMESTIC SERVICE IN RUSSIAN AT **1404 GMT** ON 28 OCTOBER” e encerra com linha `28 OCT 928A FRK/HM`. | **Fac-símile primário preservado no arquivo presidencial Kennedy/NARA**, texto indexado diretamente consultado; captura visual da página bloqueada com 403: https://nara-media.s3.amazonaws.com/presidential-libraries/kennedy/POF/JFKPOF-114a-015/JFKPOF-114a-015.pdf . História institucional CIA *FBIS 1941–1971* também reproduz o texto https://www.cia.gov/readingroom/docs/CIA-RDP90-01137R000100200002-5.pdf . | **Confirmado uso de GMT em telegrama FBIS de mesmo gênero um ano antes**, inclusive distinção entre hora de emissão e data/hora de roteamento na linha inferior. **Ainda NÃO confirmado que `2330 8 NOV 63 W` do caso Conde use necessariamente GMT**, porque o documento de Conde não escreve `GMT` e o significado de `W` não foi elucidado. |", grade := none, outcome := none, chain := none },
  { id := 108, variant := 1, uniqueId := "C108", summary := "Se `2330` FBIS do Conde = 23h30 GMT, então hora Rio (Guanabara) = 21h30 e Conde (Bahia) = 20h30 em 8/11/1963, pelo horário de verão em Guanabara e hora padrão baiana.", sourceRow := "| **C108** | Se `2330` FBIS do Conde = 23h30 GMT, então hora Rio (Guanabara) = **21h30** e Conde (Bahia) = **20h30** em 8/11/1963, pelo horário de verão em Guanabara e hora padrão baiana. | **Inferência condicional** dos decretos 52.700/1963 e 53.071/1963 anteriormente verificados; a regra FBIS está mais sustentada, não definitivamente estabelecida. | **Reforçado o cenário GMT para teste orbital**, mas manter ramo alternativo em qualquer simulação até que uma convenção editorial FBIS de 1963 seja localizada. |", grade := none, outcome := none, chain := none },
  { id := 109, variant := 1, uniqueId := "C109", summary := "Índice da biblioteca de Illinois rotula uma digitalização *Broadcasting stations of the world* como “Volume 1963, parts 1 and 2”, mas a própria folha de rosto OCR mostra “1 June 1966”, 20ª edição. O volume separado “1963, part 3” tem capa “1 March 1963”, 18ª edição e lista TV/FM, não AM.", sourceRow := "| **C109** | Índice da biblioteca de Illinois rotula uma digitalização *Broadcasting stations of the world* como “Volume 1963, parts 1 and 2”, mas a própria folha de rosto OCR mostra **“1 June 1966”, 20ª edição**. O volume separado “1963, part 3” tem capa **“1 March 1963”, 18ª edição** e lista TV/FM, não AM. | **Documentação editorial original e metadados de catálogo verificados**: https://libsysdigi.library.illinois.edu/oca/Books2007-07/broadcastingstat/ ; texto 1966 https://libsysdigi.library.illinois.edu/oca/Books2007-07/broadcastingstat/broadcastingstat63unit/broadcastingstat63unit_djvu.txt ; texto 1963 https://libsysdigi.library.illinois.edu/oca/Books2007-07/broadcastingstat/broadcasting63unit/broadcasting63unit_djvu.txt | **Refutada a atribuição de dados AM do PDF 1966 ao ano de 1963.** Necessário localizar 18ª edição de 1963 das partes 1/2 para reconstruir frequências da Rádio Tupi da época. |", grade := none, outcome := none, chain := none },
  { id := 110, variant := 1, uniqueId := "C110", summary := "Foram examinadas por pesquisa textual as edições de *O Estado* de 8, 10, 12/11/1963 (nº 14.806–14.808), sem correspondência relevante do incidente de Conde. A palavra “Conde” em 12/11 ocorre como título de nobreza em notícia inglesa.", sourceRow := "| **C110** | Foram examinadas por pesquisa textual as edições de *O Estado* de **8, 10, 12/11/1963** (nº 14.806–14.808), sem correspondência relevante do incidente de Conde. A palavra “Conde” em 12/11 ocorre como título de nobreza em notícia inglesa. | **Busca negativa por indexação OCR**, fontes https://hemeroteca.ciasc.sc.gov.br/oestadofpolis/1963/EST196314806.pdf , `EST196314807.pdf`, `EST196314808.pdf` . **Não** houve inspeção visual exaustiva de todas as páginas. | **Não é comprovação de ausência editorial**, muito menos ausência de queda; reduz apenas probabilidade de uma notícia facilmente indexada naquele jornal. |", grade := none, outcome := none, chain := none },
  { id := 111, variant := 1, uniqueId := "C111", summary := "Roteiros fac-similares 8/11, documento `RE19631108.pdf` (24 pp.) e 9/11, `RE19631109.pdf` (24 pp.) lidos integralmente.", sourceRow := "| **C111** | Roteiros fac-similares **8/11**, documento `RE19631108.pdf` (**24 pp.**) e **9/11**, `RE19631109.pdf` (**24 pp.**) lidos integralmente. | **Documentos primários de redação, conteúdo diretamente conferido em todas as páginas.** https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631108.pdf ; https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631109.pdf | **Nenhuma menção identificada à cidade de Conde, esfera/satélite caído, cadáver, inscrições, cratera, balão caído ou Peropava nos roteiros preservados.** Não inferir ausência em outro programa ou no rádio do Rio. |", grade := some .originalInspected, outcome := some .confirmedAsDocument, chain := some .miscellaneous },
  { id := 112, variant := 1, uniqueId := "C112", summary := "Roteiro 11/11, `RE19631111.pdf` (23 pp.), lido integralmente, incluindo nota internacional (página 7 do PDF, número impresso 7) e notícia final (página 23 PDF).", sourceRow := "| **C112** | Roteiro **11/11**, `RE19631111.pdf` (**23 pp.**), lido integralmente, incluindo nota internacional (página **7 do PDF**, número impresso 7) e notícia final (página 23 PDF). | **Documento primário coetâneo, visualmente verificado.** https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631111.pdf | **Nenhuma menção a Conde ou Peropava em todo o roteiro**, mas **há nota explicitamente espacial**, cf. C113. |", grade := some .originalInspected, outcome := some .confirmedAsDocument, chain := some .miscellaneous },
  { id := 113, variant := 1, uniqueId := "C113", summary := "Em 11/11, folha 7 (índice do PDF 6), o bloco internacional contém: “A Força Aérea dos Estados Unidos lançou hoje um satélite secreto e disparou um projétil para um alvo no Pacífico. De acôrdo com a política de reserva adotada, não há mais pormenores.”", sourceRow := "| **C113** | Em 11/11, folha 7 (índice do PDF **6**), o bloco internacional contém: “A Força Aérea dos Estados Unidos lançou hoje um satélite secreto e disparou um projétil para um alvo no Pacífico. De acôrdo com a política de reserva adotada, não há mais pormenores.” | **Citação literal curta de fonte primária da redação**: https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631111.pdf#page=7 | **Confirmado que notícias espaciais eram pautadas no telejornal paulista, apesar de Conde não figurar.** **Não identificar o satélite/objeto**, e não confundir este lançamento noticiado em **11/11** com as reentradas NORAD 528 (8/11) e 637 (7/11). O texto é uma nota jornalística, não prova de lançamento. |", grade := none, outcome := none, chain := none },
  { id := 114, variant := 1, uniqueId := "C114", summary := "Roteiro 12/11, `RE19631112.pdf` (23 pp.) lido integralmente, com blocos internacionais e notícia final (página 23).", sourceRow := "| **C114** | Roteiro **12/11**, `RE19631112.pdf` (**23 pp.**) lido integralmente, com blocos internacionais e notícia final (página 23). | **Documento primário visualmente verificado**: https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631112.pdf | **Nenhuma menção à suposta esfera em Conde nem continuidade da história paulista de mergulhadores**. |", grade := some .originalInspected, outcome := some .confirmedAsDocument, chain := some .miscellaneous },
  { id := 115, variant := 1, uniqueId := "C115", summary := "Tanto 11/11 (página 22 PDF, índice 21) quanto 12/11 (página 22 PDF) atribuem explicitamente previsões do tempo ao Serviço de Meteorologia do Ministério da Aeronáutica, em Congonhas.", sourceRow := "| **C115** | Tanto 11/11 (página 22 PDF, índice 21) quanto 12/11 (página 22 PDF) atribuem explicitamente previsões do tempo ao **Serviço de Meteorologia do Ministério da Aeronáutica, em Congonhas**. | **Documentos primários diretamente lidos**: https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631111.pdf#page=22 e https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631112.pdf#page=22 | Evidencia fornecimento normal de **previsões gerais do tempo** à TV Tupi São Paulo. **Não** é registro de radiossondagem em Conde nem comprova ligação entre serviços meteorológicos baianos e o rumor. |", grade := none, outcome := none, chain := none },
  { id := 116, variant := 1, uniqueId := "C116", summary := "Os roteiros contêm anotações de produção, cortes assinalados com grandes “X”, correções e cabeçalhos “filme interno”, “notícia final”.", sourceRow := "| **C116** | Os roteiros contêm anotações de produção, cortes assinalados com grandes “X”, correções e cabeçalhos “filme interno”, “notícia final”. | **Observação material direta** de versões de redação: https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631111.pdf e outras datas. | **Limite metodológico:** ausência no roteiro preservado **não prova** inexistência de uma fala improvisada, boletim diferente, áudio posterior ou transmissão pela rádio do Rio. Não confundir com registro audiovisual integral da transmissão. |", grade := none, outcome := none, chain := none },
  { id := 117, variant := 1, uniqueId := "C117", summary := "Depois da manchete original Peropava/Iguape no roteiro de 7/11 (C103), os quatro roteiros preservados examinados de 8, 9, 11 e 12/11 não repetem o caso paulista e não anunciam Conde.", sourceRow := "| **C117** | Depois da manchete original **Peropava/Iguape** no roteiro de 7/11 (C103), os quatro roteiros preservados examinados de **8, 9, 11 e 12/11** não repetem o caso paulista e não anunciam Conde. | **Comparação interna do corpus primário**; 7/11 https://media.bcc.org.br/documento/roteiro/tupi/pdf/RE19631107.pdf e quatro roteiros acima. | **Enfraquece hipótese específica de retransmissão textual direta da notícia de Conde pelo *Repórter Esso* TV São Paulo**, mas **não elimina contaminação temática entre redações** ou compartilhamento de agências e boatos. Não são testemunhos físicos de queda. |", grade := none, outcome := none, chain := none },
  { id := 118, variant := 1, uniqueId := "C118", summary := "O projeto institucional História da Bahia — Da memória impressa ao conteúdo digital digitalizou cerca de 750 mil páginas do diário *A Tarde*, da fundação em 1912 até 31/12/1999; a fase 1956–1999 foi concluída, conforme nota publicada pela empresa parceira Humanidades em 31/07/2012. https://www.humanidades.com.br/noticias/detalhe/noticia/projeto-em-parceria-com-a-humanidades-esta-disponivel-em-biblioteca-da-bahia/", sourceRow := "| **C118** | O projeto institucional **História da Bahia — Da memória impressa ao conteúdo digital** digitalizou cerca de **750 mil páginas** do diário *A Tarde*, da fundação em 1912 até **31/12/1999**; a fase **1956–1999** foi concluída, conforme nota publicada pela empresa parceira Humanidades em **31/07/2012**. https://www.humanidades.com.br/noticias/detalhe/noticia/projeto-em-parceria-com-a-humanidades-esta-disponivel-em-biblioteca-da-bahia/ | **Fonte institucional diretamente consultada (2012), sobre EXISTÊNCIA DE DIGITALIZAÇÃO, não leitura de jornal de 1963.** | **Confirmado que novembro/1963 está no intervalo do projeto digitalizado.** A notícia não audita lacunas de fascículos individuais. **Ressalva:** a notícia traz data 31/07/2012, mas diz que a apresentação ocorreu em uma quinta-feira 30/11; há incoerência interna na cronologia, insuficiente para invalidar o fato básico da digitalização. NÃO constitui fonte primária sobre a esfera nem corroboração de queda. |", grade := none, outcome := none, chain := none },
  { id := 119, variant := 1, uniqueId := "C119", summary := "Nota oficial do governo baiano, 27/01/2010, informa terminais Ilhas do Conhecimento na Biblioteca Pública dos Barris e no Arquivo Público da Bahia, com busca de páginas de *A Tarde* por data, nome e palavra-chave via OCR. https://www.ba.gov.br/comunicacao/2010/01/noticias/fundo-de-cultura-apoia-digitalizacao-de-edicoes-do-seculo-20-do-jornal-a-tarde", sourceRow := "| **C119** | Nota oficial do governo baiano, **27/01/2010**, informa terminais **Ilhas do Conhecimento** na Biblioteca Pública dos Barris e no Arquivo Público da Bahia, com busca de páginas de *A Tarde* por **data, nome e palavra-chave via OCR**. https://www.ba.gov.br/comunicacao/2010/01/noticias/fundo-de-cultura-apoia-digitalizacao-de-edicoes-do-seculo-20-do-jornal-a-tarde | **Fonte oficial institucional de primeira mão**, sobre implantação e método de acesso. | **Confirmado o plano e a implementação institucional histórica de indexação OCR presencial**, anterior à fase 1956–1999. **Não foi verificado que os terminais ainda funcionem em 2026**, nem que acesso externo à coleção exista. Consulta por **7, 8, 9, 10, 11, 12/11/1963** e pelas variantes `Conde`, `satélite`, `objeto`, `balão`, `cratera`, `disco voador`, `homem do espaço` é caminho mais concreto que repetir busca web. |", grade := none, outcome := none, chain := none },
  { id := 120, variant := 1, uniqueId := "C120", summary := "A Fundação Pedro Calmon publicou em 24/02/2026 ferramenta geral de pesquisa nos acervos da Biblioteca Pública e do Arquivo Público da Bahia, nomeando plataformas Pergamum e ATOM; página atualizada em 08/07/2026. https://www.ba.gov.br/fpc/ferramenta-de-pesquisa", sourceRow := "| **C120** | A Fundação Pedro Calmon publicou em **24/02/2026** ferramenta geral de pesquisa nos acervos da Biblioteca Pública e do Arquivo Público da Bahia, nomeando plataformas **Pergamum** e **ATOM**; página atualizada em 08/07/2026. https://www.ba.gov.br/fpc/ferramenta-de-pesquisa | **Fonte oficial contemporânea**, sobre infraestrutura de consulta da fundação. | **Não se pode inferir** que o OCR integral de *A Tarde* esteja publicado no ATOM ou no Pergamum: a página não o afirma. Acesso remoto às edições de novembro/1963 **não identificado** nesta sessão. |", grade := none, outcome := none, chain := none },
  { id := 121, variant := 1, uniqueId := "C121", summary := "Instituto Geográfico e Histórico da Bahia registra fundos físicos *Diário de Notícias* (1875–1980), *Jornal da Bahia* (1959–1994), *A Tarde* e *Estado da Bahia*, cobrindo 1963. https://www.ighb.org.br/biblioteca", sourceRow := "| **C121** | Instituto Geográfico e Histórico da Bahia registra fundos físicos *Diário de Notícias* (1875–1980), *Jornal da Bahia* (1959–1994), *A Tarde* e *Estado da Bahia*, cobrindo 1963. https://www.ighb.org.br/biblioteca | **Fonte institucional de descrição arquivística, já conhecida em rodadas anteriores, reconfirmada.** | **Mantém-se a rota dos dois recortes citados no A-628**, sem promover catálogos e metadados a jornais diretamente lidos. O projeto digital de *A Tarde* constitui **rota editorial independente** (distinta dos recortes que o consulado guardou). |", grade := none, outcome := none, chain := none },
  { id := 122, variant := 1, uniqueId := "C122", summary := "Buscas novas em índices web por expressões da época, combinações `Conde/satélite/balão/novembro/1963`, títulos e campos de *A Tarde*, *Diário de Notícias*, *Jornal da Bahia*, *Estado da Bahia*, e variantes de registro da Rádio Tupi. Foram encontrados sobretudo textos republicados em agosto–novembro de 2026, que derivam dos três documentos PURSUE de 1963.", sourceRow := "| **C122** | Buscas novas em índices web por expressões da época, combinações `Conde/satélite/balão/novembro/1963`, títulos e campos de *A Tarde*, *Diário de Notícias*, *Jornal da Bahia*, *Estado da Bahia*, e variantes de registro da Rádio Tupi. Foram encontrados sobretudo textos republicados em agosto–novembro de **2026**, que derivam dos três documentos PURSUE de 1963. | **Resultado negativo de indexação**, sem leitura de fascículos de 1963 novos. | **Nenhuma primeira notícia anterior ao FBIS, recorte do A-628 ou testemunho novo recuperado.** Não contar dezenas de portais posteriores como confirmação independente. Obstáculo atual: ausência de acesso web verificável à digitalização *A Tarde* 1963; eventual consulta deve ser presencial ou por acesso que venha a ser demonstrado, sem contato não autorizado. |", grade := none, outcome := none, chain := none },
  { id := 123, variant := 1, uniqueId := "C123", summary := "Histórico 528 (45 elementos) e 529 (57) até final de 1963", sourceRow := "| C123 | Histórico 528 (45 elementos) e 529 (57) até final de 1963 | Dados de elementos orbitais históricos públicos do conjunto `oxzoid/space-track-tle-history`; derivam da linhagem de rastreamento militar | Matéria-prima para validação, **não confirmação instrumental independente** de reentrada em Conde |", grade := none, outcome := none, chain := none },
  { id := 124, variant := 1, uniqueId := "C124", summary := "Inclinação e vetor médio do 528 em 27/10 às 14:40 UTC", sourceRow := "| C124 | Inclinação e vetor médio do 528 em 27/10 às 14:40 UTC | Elemento orbital histórico reconstruído, epoch diretamente documentada | Latitude acessível ±81,8615°; velocidade nominal ~7,70 km/s; longitude da reentrada não determinada |", grade := none, outcome := none, chain := none },
  { id := 125, variant := 1, uniqueId := "C125", summary := "Variação do nodo ascendente 17–27/10", sourceRow := "| C125 | Variação do nodo ascendente 17–27/10 | **Inferência matemática** da diferença entre TLEs contemporâneos | RAAN ~-1,1447°/dia; permite aproximação do plano em Nov/1963, não da fase |", grade := none, outcome := none, chain := none },
  { id := 126, variant := 1, uniqueId := "C126", summary := "Alinhamento do plano orbital com Conde em 8/11", sourceRow := "| C126 | Alinhamento do plano orbital com Conde em 8/11 | **Simulação geométrica condicional**, não detecção de passagem | ~11h35 e 23h44 UTC, isto é, ~08h35 e 20h44 na Bahia; requer fase orbital correta e sobrevivência do fragmento |", grade := none, outcome := none, chain := none },
  { id := 127, variant := 1, uniqueId := "C127", summary := "Dois testes cegos de ~10,15 dias no próprio 528", sourceRow := "| C127 | Dois testes cegos de ~10,15 dias no próprio 528 | **Resultado computacional, código e logs Kaggle preservados** | Ajustes prévios ~1 e ~4 km; erros de previsão 5.692 e 4.504 km; falha da extrapolação precisa |", grade := none, outcome := none, chain := none },
  { id := 128, variant := 1, uniqueId := "C128", summary := "Teste cego 529 por ~11,8–12,3 dias", sourceRow := "| C128 | Teste cego 529 por ~11,8–12,3 dias | **Resultado computacional com TLEs reservados** | Erros 2.426 a 5.465 km nas calibrações analisadas, BSTAR ≥0; não são probabilidades de localização do 528 |", grade := none, outcome := none, chain := none },
  { id := 129, variant := 1, uniqueId := "C129", summary := "Validação de 528 por 2 dias", sourceRow := "| C129 | Validação de 528 por 2 dias | **Resultado computacional** | Em teste curto (25→27/10), erro com arrasto ajustado ~651 km, pior que a extrapolação sem arrasto (~89 km), mostrando que ajuste não melhora sempre |", grade := none, outcome := none, chain := none },
  { id := 130, variant := 1, uniqueId := "C130", summary := "Proposição ‘sabemos com bastante certeza que foi em Conde’", sourceRow := "| C130 | Proposição ‘sabemos com bastante certeza que foi em Conde’ | **Hipótese confrontada com controle fora da amostra** | **Não sustentada**; data e latitude permitem, mas não identificam ponto de reentrada ou impacto; hipóteses rivais permanecem abertas |", grade := none, outcome := none, chain := none },
  { id := 131, variant := 1, uniqueId := "C131", summary := "Primária contemporânea, fac-símile verificado", sourceRow := "| C131 | **Primária contemporânea, fac-símile verificado** | NASA, *Satellite Situation Report* 15/11/1963, página 8 | NORAD 528 = `1963 3B` decaimento em **8/11**; 637 = `1963 35A` decaimento **7/11**; sem hora/local |", grade := none, outcome := none, chain := none },
  { id := 132, variant := 1, uniqueId := "C132", summary := "Primária institucional retrospetiva", sourceRow := "| C132 | **Primária institucional retrospetiva** | House Report 197 (1965), seção V.A | NASA recebe/compila com NORAD/Smithsonian; **data NASA e TLE não são necessariamente fontes independentes de radar** |", grade := none, outcome := none, chain := none },
  { id := 133, variant := 1, uniqueId := "C133", summary := "Inferência matemática / retrovalidação", sourceRow := "| C133 | **Inferência matemática / retrovalidação** | Série RAAN 528 outubro, leave-future-out | Erro médio 0,031–0,038° em horizontes 2–6 dias; não testa 12 dias terminais |", grade := none, outcome := none, chain := none },
