-- Conteudo completo da matriz e carregado sem transformar texto de origem em prova fisica.
def allClaimIdentifiers : Array Nat := evidenceRows.map (fun x => x.id)
def numberOfPropositions : Nat := evidenceRows.size
def distinctClaimIdentifiers : List Nat := evidenceRows.toList.map (fun x => x.id) |>.eraseDups
def numberOfClaimCodes : Nat := distinctClaimIdentifiers.length
def numberOfManuallyClassified : Nat := (evidenceRows.filter (fun x => x.grade.isSome)).size
#eval numberOfPropositions
#eval numberOfClaimCodes
#eval numberOfManuallyClassified
end Conde1963
