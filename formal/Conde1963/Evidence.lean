  { id := 45, variant := 1, uniqueId := "C45.1", summary := "Camada geológica sobre o mesmo ponto: Qmc, depósitos marinhos e continentais costeiros, areia/argila/sedimento eólico inconsolidado; qualidade indireta", sourceRow := "| C45 | Camada geológica sobre o mesmo ponto: **Qmc, depósitos marinhos e continentais costeiros**, areia/argila/sedimento eólico inconsolidado; qualidade indireta | Camada 48 da CONDER; mapeamento regional atual não histórico | **Verificado como classificação cartográfica, não prova de estratigrafia a 5 m** |", grade := none, outcome := none, chain := none },
  { id := 45, variant := 2, uniqueId := "C45.2", summary := "Quatro soluções prévias com queda condicionada em Conde", sourceRow := "| C45 | Quatro soluções prévias com queda condicionada em Conde | Inferência de modelo / tentativa de falsificação | Retroprevisão 17/10: erros de fase −21,1°, +102,4°, −70,6° e +42,4°; sem validação anterior adequada |", grade := none, outcome := none, chain := none },
  { id := 46, variant := 1, uniqueId := "C46.1", summary := "Se manter a forma orbital e a massa/área inferida do 528, uma esfera de diâmetro 2m teria ~39 kg, ~20m/s, ~8 kJ e exigiria resistência ~0,77 kPa para penetrar 4m; esfera pesada de ~977kg exigiria área orbital muito maior e uma mudança estrutural", sourceRow := "| C46 | Se manter a forma orbital e a massa/área inferida do 528, uma esfera de diâmetro 2m teria ~39 kg, ~20m/s, ~8 kJ e exigiria resistência ~0,77 kPa para penetrar 4m; esfera pesada de ~977kg exigiria área orbital muito maior e uma mudança estrutural | Deriva de C39, esfera geométrica, Cd distintos, atmosfera e resistência não validados; comparações condicionalmente dependentes | **Fortemente desfavorável à hipótese esfera pesada intacta sem mudança de forma; não é exclusão de reentrada nem do relato por si só** |", grade := none, outcome := none, chain := none },
  { id := 46, variant := 2, uniqueId := "C46.2", summary := "Ajuste simultâneo à fase e à frequência orbital antes de 27/10", sourceRow := "| C46 | Ajuste simultâneo à fase e à frequência orbital antes de 27/10 | Inferência quantitativa | Com 529 até 05/11: H≈111,8 km, K≈0,010574 rev/d²; RMSE aproximadamente 1,88° e 0,00134 rev/d. Atmosfera não medida diretamente |", grade := none, outcome := none, chain := none },
  { id := 47, variant := 1, uniqueId := "C47", summary := "Reentrada condicionada a Conde sob multiplicador de arrasto constante", sourceRow := "| C47 | Reentrada condicionada a Conde sob multiplicador de arrasto constante | Falsificação dentro do modelo | Resíduos de fase normalmente 60–120° quando H/K são ajustados aos TLEs anteriores; arrasto uniforme insuficiente |", grade := none, outcome := none, chain := none },
  { id := 48, variant := 1, uniqueId := "C48", summary := "Multiplicadores distintos em duas etapas pós-27/10", sourceRow := "| C48 | Multiplicadores distintos em duas etapas pós-27/10 | Inferência condicional | 29 raízes na busca inicial de 16 conjuntos de cenários (contagem não exaustiva). Exemplo com corte 02/11 e 529 como proxy: A1=1,400 e A2=3,239; horários 20h43; não equivale a observação física |", grade := none, outcome := none, chain := none },
  { id := 49, variant := 1, uniqueId := "C49", summary := "Índices geomagnéticos Ap 29/10, 07/11, 08/11", sourceRow := "| C49 | Índices geomagnéticos Ap 29/10, 07/11, 08/11 | Série instrumental compilada | 74, 39, 46 respectivamente; podem motivar cortes, não confirmar mudanças do coeficiente balístico do 528 |", grade := none, outcome := none, chain := none },
  { id := 50, variant := 1, uniqueId := "C50", summary := "Previsão do 529 até 17/11 sem usar TLE posterior", sourceRow := "| C50 | Previsão do 529 até 17/11 sem usar TLE posterior | Inferência / controle | Erro depende do intervalo de treino: oito registros até 05/11 dão −0,000036 rev/d; quatro últimos dão −0,002801 rev/d |", grade := none, outcome := none, chain := none },
  { id := 51, variant := 1, uniqueId := "C51", summary := "Modelo de penetração com massa do núcleo de 200 kg, sem impor a profundidade", sourceRow := "| C51 | Modelo de penetração com massa do núcleo de 200 kg, sem impor a profundidade | Simulação hipotética | 0,5–5 m requerem resistência dinâmica média entre ~80,8 e ~8,1 MPa; não mede propriedades reais de Conde |", grade := none, outcome := none, chain := none },
  { id := 52, variant := 1, uniqueId := "C52", summary := "Concordância completa com 3D-SGP4 e atmosfera termodinâmica física", sourceRow := "| C52 | Concordância completa com 3D-SGP4 e atmosfera termodinâmica física | Questão aberta | Não demonstrada; dados BSTAR zerados e arquivos incompletos impedem aceitar um traçado como reconstrução histórica |", grade := none, outcome := none, chain := none },
  { id := 53, variant := 1, uniqueId := "C53", summary := "Resolução mais fina do espaço de parâmetros (corte 02/11)", sourceRow := "| C53 | Resolução mais fina do espaço de parâmetros (corte 02/11) | Inferência / tentativa de falsificação | H≈111,8 km em ajuste sem teto artificial de 110 km; dez raízes distintas, cinco por passagem. A1/A2 noturna em uma família ≈1,391/3,301; a multiplicidade aumenta, não reduz. |", grade := none, outcome := none, chain := none },
  { id := 54, variant := 1, uniqueId := "C54", summary := "O lançamento 1963-003A é o FTV 2313/OPS 0180, missão 7153, Group 1-D, satélite ELINT Ferret 3 em Thor-Agena B", sourceRow := "| C54 | O lançamento 1963-003A é o FTV 2313/OPS 0180, missão 7153, Group 1-D, satélite ELINT Ferret 3 em Thor-Agena **B** | NRO, *The SIGINT Satellite Story*, compilação institucional de participantes do programa (1994, desclassificada), p. do trecho sobre 16/01/1963: https://www.nro.gov/Portals/65/documents/foia/declass/HISTORICALLY%20SIGNIFICANT%20DOCs/NRO%2060th%20Anniversary%20Docs/SC-2021-00003_C05134315.pdf ; GCAT https://planet4589.org/space/gcat/data/launch/Thor.html | Documento institucional sobre programa e catalogação independente de lançamento; missão confirmada, identidade dos detritos aberta |", grade := none, outcome := none, chain := none },
  { id := 55, variant := 1, uniqueId := "C55", summary := "528 e 529 são dois componentes catalogados e separados desde perto do lançamento de 16/01/1963, não é demonstrado que foram produzidos por fragmentação em novembro", sourceRow := "| C55 | 528 e 529 são dois componentes catalogados e separados desde perto do lançamento de 16/01/1963, não é demonstrado que foram produzidos por fragmentação em novembro | GCAT registros S00528, S00529 (1963-003B/C), https://planet4589.org/space/gcat/data/cat/satcat.html | Dados de compilação orbital, sem identificação física; datas da separação aproximadas/assinaladas com ? |", grade := none, outcome := none, chain := none },
  { id := 56, variant := 1, uniqueId := "C56", summary := "Missão predecessora 7152 (18/06/1962) deixou objetos NORAD 310 e 314 descritos como “Ferret sensor cover?”", sourceRow := "| C56 | Missão predecessora 7152 (18/06/1962) deixou objetos NORAD 310 e 314 descritos como **“Ferret sensor cover?”** | Linhas S00310/S00314 do GCAT, https://planet4589.org/space/gcat/data/cat/satcat.html | Hipótese editorial do catalogador com ponto de interrogação. **Não é confirmação** de que os objetos 528/529 eram coberturas |", grade := none, outcome := none, chain := none },
